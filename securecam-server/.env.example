# SecureCam Signaling Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Security & Tokens
JWT_SECRET="securecam_super_secret_jwt_key_replace_in_production"
TOKEN_EXPIRY_DAYS=30

# WebRTC STUN & TURN Relay Servers
STUN_SERVER="stun:stun.l.google.com:19302"
TURN_SERVER="turn:turn.yourdomain.com:3478"
TURN_USERNAME="securecam_turn_user"
TURN_PASSWORD="securecam_turn_password"

# TLS / HTTPS (For standalone Node server)
SSL_CERT_PATH="/etc/letsencrypt/live/yourdomain.com/fullchain.pem"
SSL_KEY_PATH="/etc/letsencrypt/live/yourdomain.com/privkey.pem"
